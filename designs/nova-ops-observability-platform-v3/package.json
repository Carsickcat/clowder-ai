{
  "name": "nova-ops-observability-platform-v3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5290",
    "build": "next build && node scripts/prepare-dist.mjs",
    "start": "node serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/golden-path.browser.mjs",
    "evidence:video": "node tests/evidence-recording.mjs",
    "format": "prettier --write \"app/**/*.{js,css}\" \"components/**/*.js\" \"lib/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.{md,mjs,json}\"",
    "format:check": "prettier --check \"app/**/*.{js,css}\" \"components/**/*.js\" \"lib/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.{md,mjs,json}\"",
    "check": "npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "next": "15.5.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "playwright-core": "^1.62.0",
    "prettier": "^3.6.2"
  }
}
